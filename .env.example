# ─── PlantBot Environment Configuration ───────────────────────────────────────

# LLM Provider (gemini | openai)
LLM_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# CNN Model
MODEL_PATH=./plant_disease/plant_disease_98.pth
CLASS_NAMES_PATH=./plant_disease/class_names.json

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./plantbot.db

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
