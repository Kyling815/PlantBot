{
  "name": "CNN Diagnosis Workflow",
  "nodes": [
    {
      "parameters": {},
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/api/predict",
        "method": "POST",
        "sendBody": true,
        "options": {}
      },
      "name": "Call CNN API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "label",
              "value": "={{ $json.data.label }}"
            },
            {
              "name": "confidence",
              "value": "={{ $json.data.confidence }}"
            },
            {
              "name": "status",
              "value": "={{ $json.data.status }}"
            }
          ]
        }
      },
      "name": "Format Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{"node": "Call CNN API", "type": "main", "index": 0}]]
    },
    "Call CNN API": {
      "main": [[{"node": "Format Result", "type": "main", "index": 0}]]
    }
  }
}
