{
  "name": "PlantBot Main Workflow",
  "nodes": [
    {
      "parameters": {
        "path": "plantbot",
        "responseMode": "lastNode",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/api/predict",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "file",
              "value": "={{ $json.body.file }}"
            }
          ]
        }
      },
      "name": "CNN Predict",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.data.status }}",
              "operation": "equals",
              "value2": "Disease detected"
            }
          ]
        }
      },
      "name": "Disease Detected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}"
      },
      "name": "Return Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{"node": "CNN Predict", "type": "main", "index": 0}]]
    },
    "CNN Predict": {
      "main": [[{"node": "Disease Detected?", "type": "main", "index": 0}]]
    },
    "Disease Detected?": {
      "main": [[{"node": "Return Response", "type": "main", "index": 0}]]
    }
  }
}
